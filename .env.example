# Server
NODE_ENV=production
PORT=3000
TRUST_PROXY_HOPS=1
MAX_UPLOAD_MB=12
OCR_TIMEOUT_MS=120000
AI_REQUESTS_PER_MINUTE=8
GENERAL_REQUESTS_PER_MINUTE=120

# Add your actual Render website origin (no trailing slash).
ALLOWED_ORIGIN=https://your-service.onrender.com

# Existing API providers (keep keys private)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OCR_SPACE_API_KEY=
OCR_SPACE_LANGUAGE=eng
OCR_SPACE_ENGINE=2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OTHER_AI_BASE_URL=
OTHER_AI_API_KEY=
OTHER_AI_MODEL=

# Local Tesseract OCR
TESSERACT_ENABLED=true
TESSERACT_LANGUAGES=ben+eng
TESSERACT_PSM=3

# First successful provider selected as primary
OCR_PROVIDER_PRIORITY=chatgpt,gemini,tesseract,other,ocrspace
