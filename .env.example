PORT=3000
MAX_UPLOAD_MB=12
AI_REQUESTS_PER_MINUTE=12

# ChatGPT/OpenAI vision OCR
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=12000

# Gemini vision OCR
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OCR.space (optional; language support varies by script)
OCR_SPACE_API_KEY=
OCR_SPACE_LANGUAGE=eng
OCR_SPACE_ENGINE=2

# Optional OpenAI-compatible vision endpoint
OTHER_AI_BASE_URL=
OTHER_AI_API_KEY=
OTHER_AI_MODEL=

# If frontend and backend are hosted on different domains, add exact frontend origin(s), comma-separated.
# Leave blank for same-origin hosting.
ALLOWED_ORIGIN=
